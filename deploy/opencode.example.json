{
  "identity_file": "/etc/multica-sandbox/identity.json",
  "authority": {
    "url": "https://attempts.example.com/v1/attempts",
    "bearer_file": "/run/secrets/attempt-authority"
  },
  "network": "approved-mcp-template",
  "peers": [
    "corporate-mcp",
    "multica-sandbox-controller"
  ],
  "multica_relay": {
    "listen": ":8091",
    "url": "http://multica-relay:8091"
  },
  "inference_file": "/etc/multica-sandbox/inference.json",
  "inference_relay": {
    "listen": ":8092",
    "url": "http://inference-relay:8092"
  }
}
